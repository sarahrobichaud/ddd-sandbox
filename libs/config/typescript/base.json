{
  "compilerOptions": {
    "checkJs": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "moduleResolution": "nodeNext",
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "target": "es2022"
  }
}
